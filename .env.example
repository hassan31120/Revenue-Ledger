APP_NAME="Instructor Revenue Ledger"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://instructor-revenue-ledger.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=instructor_revenue_ledger
DB_USERNAME=root
DB_PASSWORD=

# The Pest suite runs against a SEPARATE MySQL database, configured in phpunit.xml
# rather than here (instructor_revenue_ledger_test). It must be MySQL: the financial
# invariants are CHECK constraints, a generated-column unique index, triggers and
# row locks, none of which SQLite supports faithfully.

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Instructor Revenue Ledger -------------------------------------------------
# All money is stored as integer minor units of this currency (EGP 100.50 = 10050).
REVENUE_CURRENCY=EGP

# Platform commission in basis points (3000 = 30.00%). Snapshotted onto each
# subscription at purchase, so changing it never rewrites historical money.
REVENUE_PLATFORM_FEE_BPS=3000

# Minimum payable balance, in minor units (10000 = EGP 100.00).
PAYOUTS_MINIMUM_MINOR=10000

# Mock provider outcome:
#   success | permanent_failure | timeout_after_success | timeout_before_success
PAYOUTS_MOCK_MODE=success

# Delay before reconciling a payout left in the "unknown" state.
PAYOUTS_RECONCILE_DELAY_SECONDS=60

# How long the provider gets to register a payment before "no record" is accepted
# as proof that no money moved.
PAYOUTS_NOT_FOUND_GRACE_SECONDS=300

# A payout stuck in "processing" longer than this is treated as a crashed worker.
PAYOUTS_STALE_PROCESSING_MINUTES=15
