APP_NAME="Instructor Revenue Ledger"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=https://instructor-revenue-ledger.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=instructor_revenue_ledger
DB_USERNAME=root
DB_PASSWORD=

# Separate database for the Pest suite. Financial invariants are enforced by MySQL
# (CHECK constraints, STORED generated columns, row locks), so tests must run on MySQL.
DB_TEST_DATABASE=instructor_revenue_ledger_test

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Instructor Revenue Ledger -------------------------------------------------
# Platform commission in basis points (3000 = 30.00%). Snapshotted onto each
# subscription at purchase time, so changing this never rewrites historical money.
PAYOUTS_PLATFORM_FEE_BPS=3000

# Minimum payable balance, in minor units (10000 = EGP 100.00).
PAYOUTS_MIN_AMOUNT_MINOR=10000

# Mock provider outcome: success | permanent_failure | timeout_after_success | timeout_before_success
PAYOUTS_MOCK_MODE=success

# How long to wait before reconciling a payout left in the "unknown" state.
PAYOUTS_RECONCILE_DELAY_SECONDS=60

# A payout stuck in "processing" longer than this is treated as a crashed worker.
PAYOUTS_STALE_PROCESSING_MINUTES=15
