{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "career180/instructor-revenue-ledger",
    "type": "project",
    "description": "Instructor Revenue Ledger — an auditable, idempotent, concurrency-safe LMS revenue and payout system.",
    "keywords": [
        "laravel",
        "ledger",
        "payouts",
        "double-entry",
        "idempotency"
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^3.3",
        "laravel/framework": "^11.44.1",
        "laravel/tinker": "^2.9"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pail": "^1.1",
        "laravel/pint": "^1.13",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.1",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0",
        "phpunit/phpunit": "^11.0.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade",
            "@php artisan filament:assets --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "policy": {
            "advisories": {
                "ignore-id": {
                    "PKSA-3r5d-mb8f-1qw9": "CRLF injection in the default email validation rule. No fix exists in the Laravel 11 line (fixed in 12.60.0+). Unreachable here: this application has no user-supplied email input and never passes a validated email into a mail header. Re-evaluate if any mail sending is added.",
                    "PKSA-mdq4-51ck-6kdq": "CVE-2026-48019 - duplicate advisory for the same CRLF email-rule issue as PKSA-3r5d-mb8f-1qw9. Same rationale.",
                    "PKSA-m5cs-t1y6-qpcs": "Temporary signed URL path confusion. No fix exists in the Laravel 11 line (fixed in 12.61.1+). Unreachable here: this application issues no temporary signed URLs. Re-evaluate if signed routes are added."
                }
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "license": "proprietary"
}
